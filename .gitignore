/build/
/cmake-build-*/
/.cache/
*.o
*.a
*.so
*.gcda
*.gcno
__pycache__/
*.pyc

# Release packages (dist/) are attached to GitHub releases, not committed.
/dist/

# Bulk generated instance archives are reproducible from tools/ + manifests/
# and are not stored in git history (see docs/REPRODUCIBILITY.md).
instances/**/*.pcf
!instances/tiny/**/*.pcf
!instances/mixed_tree.pcf

# LaTeX build artifacts (report/computational_report.tex and .pdf are
# committed; everything latexmk regenerates from them is not).
report/*.aux
report/*.log
report/*.out
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.bbl
report/*.blg
_OLD_RUNS_ARCHIVE_*/
